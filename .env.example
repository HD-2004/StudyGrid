# Copy to .env and fill in. Never commit .env.
# Only the provider you actually use needs a value.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=20

# Raw uploads are processed in memory and are not retained.
MATERIAL_MAX_UPLOAD_MB=25
MATERIAL_MAX_TEXT_CHARS=60000

# Leave blank for the single-origin container. For a split deployment, use a
# comma-separated allowlist such as https://app.example.com,https://preview.example.com.
CORS_ORIGINS=

# Public user-test storage and anonymous session security. Leave
# STUDYGRID_DB_PATH blank only for disposable local development.
STUDYGRID_DB_PATH=data/studygrid.db
PLAN_RETENTION_DAYS=30
ENVIRONMENT=development
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=studygrid_session
