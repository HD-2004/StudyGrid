{
  "name": "studygrid-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.mjs",
    "dev:vite": "vite",
    "check:boundaries": "node --test scripts/check-frontend-boundaries.test.mjs && node scripts/check-frontend-boundaries.mjs",
    "check": "npm run check:boundaries && svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check:boundaries && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@schedule-x/calendar": "4.8.0",
    "@schedule-x/theme-default": "4.8.0",
    "temporal-polyfill": "0.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tsconfig/svelte": "5.0.4",
    "svelte": "^5.57.0",
    "svelte-check": "4.1.4",
    "typescript": "5.7.3",
    "vite": "^6.4.3"
  }
}
